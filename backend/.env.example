# Local dev default (SQLite) — for Render deployment, swap to the Postgres URL Render gives you
DATABASE_URL=sqlite:///./expense_tracker.db

# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed frontend origin(s) for CORS, comma-separated
FRONTEND_ORIGINS=http://localhost:5173
